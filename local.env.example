# Copy this file to local.env and fill in development-only values.
# local.env is ignored by Git and is loaded automatically by `bun run dev`.

# Local dev bind host (defaults to 127.0.0.1 in nuxt.config.ts to avoid Windows IPv6-only ::1 issues).
NUXT_HOST=127.0.0.1

# MySQL database connection.
# TK_MYSQL_URL supports JDBC format or discrete NUXT_MYSQL_* environment variables.
TK_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/app_erp?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
TK_MYSQL_USERNAME=
TK_MYSQL_PASSWORD=

# Nitro token and timeout configuration
NUXT_AUTH_TOKEN_SECRET=
NUXT_LEGACY_TOKEN_SECRET=
NUXT_MYSQL_CONNECT_TIMEOUT_MS=5000
NUXT_MYSQL_QUERY_TIMEOUT_MS=10000
# 业务库备用入口（主地址连不上时自动切换）。必须与 TK_MYSQL_URL 指向同一份数据，
# 例如同一台库的 openp2p 隧道地址；留空则不做故障切换。
NUXT_MYSQL_HOST_FALLBACK=

# 演示账号（demo）专用数据源：登录名为 demo 的账号读写这个库，与生产库物理隔离。
# 未配置时演示域会直接报错，不会回退到生产库。演示域的写操作只落到这里。
NUXT_DEMO_MYSQL_URL=
NUXT_DEMO_MYSQL_USER=
NUXT_DEMO_MYSQL_PASSWORD=
NUXT_PROFILE_PATH=
# Jukebox embedded player settings (local dev keeps engine disabled unless explicitly enabled).
NUXT_JUKEBOX_ENGINE_MODE=embedded
NUXT_JUKEBOX_ENGINE_ENABLED=0
NUXT_JUKEBOX_STATE_PATH=
NUXT_JUKEBOX_VOLUME=70
NUXT_JUKEBOX_API_BASE_URL=
NUXT_JUKEBOX_SERVICE_TOKEN=
NUXT_JUKEBOX_MEDIA_TIMEOUT_MS=600000
# Must stay outside NUXT_PROFILE_PATH; blank uses ~/.local/share/app-erp/jukebox-media.
NUXT_JUKEBOX_MEDIA_BACKUP_PATH=
NUXT_JUKEBOX_FFPROBE_PATH=ffprobe
NUXT_JUKEBOX_MPV_PATH=mpv
# Nitro 进程外状态（sys_cache 表）过期键清理间隔；单位毫秒，默认 5 分钟。
NUXT_SYS_CACHE_CLEANUP_INTERVAL_MS=300000
NUXT_SYS_CACHE_CLEANUP_INITIAL_DELAY_MS=60000

# WeCom contacts synchronization fallback (database sys_config is preferred).
# Never commit real credentials; use the database keys wx.work.corpId and
# wx.work.corpSecretContacts in deployments where sys_config is authoritative.
NUXT_WECOM_CORP_ID=
NUXT_WECOM_CORP_SECRET=
NUXT_WECOM_CORP_SECRET_CONTACTS=
# 销售报价单企微通知中的页面链接覆盖值（只填 http(s)://主机名；例如 http://127.0.0.1 或 https://example.com）
NUXT_QUOTATION_APP_INTERNAL_URL=
NUXT_QUOTATION_APP_EXTERNAL_URL=
# Automatic contact sync. Default: enabled, every hour, first run 30 seconds after startup.
NUXT_WECOM_AUTO_SYNC_ENABLED=1
NUXT_WECOM_AUTO_SYNC_INTERVAL_MS=3600000
NUXT_WECOM_AUTO_SYNC_INITIAL_DELAY_MS=30000

# Kingdee K3Cloud WebAPI
NUXT_K3_BASE_URL=
NUXT_K3_BASE_URL_INTRANET=
NUXT_K3_DBID=
NUXT_K3_USERNAME=
NUXT_K3_PASSWORD=
NUXT_K3_APP_ID=
NUXT_K3_APP_SECRET=
NUXT_K3_CONNECT_TIMEOUT_MS=5000
NUXT_K3_REQUEST_TIMEOUT_MS=30000
# Bun 本地开发通过代理时，填写需要直连的 K3/内网主机，多个主机用逗号分隔。
NUXT_K3_NO_PROXY_HOSTS=

# Kingdee SQL Server direct query (processYield, WIP, etc.)
NUXT_SQLSERVER_K3_HOST=
NUXT_SQLSERVER_K3_HOST_FALLBACK=
# Required when the SQL Server host is an IP and Node TLS rejects IP SNI.
NUXT_SQLSERVER_K3_TLS_SERVER_NAME=
NUXT_SQLSERVER_K3_PORT=1433
NUXT_SQLSERVER_K3_DATABASE=
NUXT_SQLSERVER_K3_USER=
NUXT_SQLSERVER_K3_PASSWORD=
NUXT_SQLSERVER_K3_CONNECT_TIMEOUT_MS=5000
NUXT_SQLSERVER_K3_REQUEST_TIMEOUT_MS=30000
NUXT_SQLSERVER_K3_POOL_MAX=5
# 考勤库（外部考勤 MySQL，只读查询；密码只放 local.env / 生产环境变量）
NUXT_ATTENDANCE_MYSQL_HOST=127.0.0.1
NUXT_ATTENDANCE_MYSQL_PORT=3306
NUXT_ATTENDANCE_MYSQL_USER=root
NUXT_ATTENDANCE_MYSQL_PASSWORD=
NUXT_ATTENDANCE_MYSQL_DATABASE=attendance_db
# 天锐绿盾服务器只读 SSH 采集配置（IT资产台账一键同步，可选）
NUXT_LVDUN_SSH_HOST=
NUXT_LVDUN_SSH_PORT=22
NUXT_LVDUN_SSH_USER=administrator
NUXT_LVDUN_SSH_KEY_PATH=
# 102 生产订单结案 Nitro 迁移（默认关闭，只dry-run看候选）
NUXT_MO_CLOSE_ENABLED=0
NUXT_MO_CLOSE_INTERVAL_MS=86400000
NUXT_MO_CLOSE_INITIAL_DELAY_MS=60000
# 旧 sys_job 统一迁移（server/utils/nitro-jobs/registry.ts，默认全关，调度只跑dry-run）
NUXT_KUCUN_SYNC_CUSTOMER=
NUXT_INTERNAL_CUSTOMER_CODES=
NUXT_OVERDUE_AR_IGNORED_OWNERS=
NUXT_NITRO_JOB_KUCUN_FULL_SYNC=0
NUXT_NITRO_JOB_KUCUN_DIFF_SYNC=0
NUXT_NITRO_JOB_SUGGEST_PUSH=0
NUXT_NITRO_JOB_APPROVE_SYNC=0
NUXT_NITRO_JOB_APPROVE_SYNC_7D=0
NUXT_NITRO_JOB_KUCUN_WARNING_PUSH=0
NUXT_NITRO_JOB_BROADCAST_SYNC=0
NUXT_NITRO_JOB_UPLOAD_PATH=0
NUXT_NITRO_JOB_OVERDUE_AUTO_FREEZE=0
NUXT_NITRO_JOB_KUCUN_WARNING_SNAPSHOT=0

# 演示环境登录密码（仅本地开发测试按需填写）
TK_ADMIN_LOGIN_PASSWORD=
NUXT_DEMO_LOGIN_USERNAME=demo
TK_DEMO_LOGIN_PASSWORD=
TK_DEMO_BCRYPT_HASH=

# 企业品牌与导出报表抬头（仅在本地 local.env / 生产环境变量中填写，勿提交真实企业名到 Git）
NUXT_PUBLIC_APP_TITLE=
NUXT_PUBLIC_BRAND_TITLE=
NUXT_PUBLIC_BRAND_SUBTITLE=
NUXT_PUBLIC_BRAND_MARK=
NUXT_PUBLIC_BRAND_FOOTER=
NUXT_PUBLIC_COMPANY_NAME=
COMPANY_DISPLAY_NAME=
ATTENDANCE_COMPANY_TITLE=

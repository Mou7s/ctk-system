# Nitro server-only configuration. Copy to a private deployment environment;
# do not commit real values to the repository.
NUXT_AUTH_TOKEN_SECRET=
NUXT_LEGACY_TOKEN_SECRET=
NUXT_TOKEN_EXPIRE_MINUTES=1440

# MySQL (Application database)
NUXT_MYSQL_URL=
NUXT_MYSQL_HOST=127.0.0.1
NUXT_MYSQL_PORT=3306
NUXT_MYSQL_USER=
NUXT_MYSQL_PASSWORD=
NUXT_MYSQL_DATABASE=
NUXT_MYSQL_CONNECT_TIMEOUT_MS=5000
NUXT_MYSQL_QUERY_TIMEOUT_MS=10000

# Garnet / Redis-compatible session store
NUXT_GARNET_HOST=127.0.0.1
NUXT_GARNET_PORT=6379
NUXT_GARNET_PASSWORD=
NUXT_GARNET_DATABASE=0
NUXT_GARNET_CONNECT_TIMEOUT_MS=3000

# Kingdee K3Cloud WebAPI
NUXT_K3_BASE_URL=
NUXT_K3_BASE_URL_INTRANET=
NUXT_K3_DBID=
NUXT_K3_USERNAME=
NUXT_K3_PASSWORD=
NUXT_K3_APP_ID=
NUXT_K3_APP_SECRET=
NUXT_K3_LCID=2052
NUXT_K3_CONNECT_TIMEOUT_MS=5000
NUXT_K3_REQUEST_TIMEOUT_MS=30000

# K3 SQL Server read-only routes. The fallback host is optional.
NUXT_SQLSERVER_K3_HOST=
NUXT_SQLSERVER_K3_HOST_FALLBACK=
# Required when the SQL Server host is an IP and Node TLS rejects IP SNI.
NUXT_SQLSERVER_K3_TLS_SERVER_NAME=
NUXT_SQLSERVER_K3_PORT=1433
NUXT_SQLSERVER_K3_DATABASE=
NUXT_SQLSERVER_K3_USER=
NUXT_SQLSERVER_K3_PASSWORD=
NUXT_SQLSERVER_K3_CONNECT_TIMEOUT_MS=5000
NUXT_SQLSERVER_K3_REQUEST_TIMEOUT_MS=30000
NUXT_SQLSERVER_K3_POOL_MAX=5

# Java fallback during the migration window
NUXT_LEGACY_BACKEND_URL=http://127.0.0.1:8180
NUXT_LEGACY_BACKEND_TIMEOUT_MS=10000
NUXT_PROFILE_PATH=

# Public browser settings
NUXT_PUBLIC_APP_BASE_API=/prod-api
NUXT_PUBLIC_APP_ENV=development
NUXT_PUBLIC_ROUTER_MODE=history

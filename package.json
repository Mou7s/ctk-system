{
  "name": "ctk-system",
  "description": "An open-source Nuxt 4 + Nitro full-stack enterprise operations and manufacturing management system.",
  "license": "GPL-3.0-or-later",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --env-file=local.env run dev:nuxt",
    "dev:nuxt": "bun run --bun nuxt dev",
    "build": "bun run build:prod",
    "build:web": "bun run build:prod",
    "build:prod": "bun run --bun nuxt build",
    "test": "bun run test:nuxt",
    "test:nuxt": "bun run vitest run",
    "check": "bun run test:nuxt",
    "check:sql": "bun tools/check-sql-migration-layout.mjs",
    "lint": "eslint .",
    "generate": "bun run --bun nuxt generate",
    "preview": "bun run --bun nuxt preview",
    "verify:all": "bun run test:nuxt",
    "deploy": "bun deploy.js"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.0",
    "@pinia/nuxt": "^1.0.3",
    "@revolist/revogrid-column-select": "3.2.4",
    "@revolist/vue3-datagrid": "4.31.4",
    "@vueuse/core": "15.0.0",
    "@wangeditor/editor": "5.1.23",
    "@wangeditor/editor-for-vue": "5.1.12",
    "@wecom/jssdk": "^2.4.4",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.23",
    "echarts": "6.1.0",
    "fflate": "^0.8.3",
    "file-saver": "2.0.5",
    "fuse.js": "7.5.0",
    "js-cookie": "3.0.8",
    "jsencrypt": "3.5.4",
    "lodash-unified": "^1.0.3",
    "mssql": "^12.7.14",
    "mysql2": "^3.24.6",
    "nuxt": "4.6.4",
    "nuxt-easy-lightbox": "^1.1.0",
    "pinia": "4.1.0",
    "sharp": "^0.35.5",
    "ssh2": "^1.17.0",
    "vue": "3.5.44",
    "vue-cropper": "1.1.4",
    "vue-router": "5.4.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.151",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "nuxt-echarts": "^1.1.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}

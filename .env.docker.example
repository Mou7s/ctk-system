# 复制为 .env.docker 后填入真实配置（勿提交 .env.docker 到 Git）

# --- 宿主机挂载路径（按实际宿主机目录调整） ---
HOST_TKSERVER_FILES_DIR=/srv/TKServerFiles
HOST_MYSQL_DATA_DIR=/srv/ctk-system/mysql-data
HOST_JUKEBOX_BACKUP_DIR=/srv/ctk-system/jukebox-media
HOST_JUKEBOX_STATE_DIR=/srv/ctk-system/jukebox-state
HOST_PULSE_SOCKET_DIR=/run/user/1000/pulse
HOST_SSH_DIR=/srv/ctk-system/ssh
MYSQL_BIND_HOST=127.0.0.1

# --- MySQL（可连独立 MySQL 或启用 --profile local-db 使用容器内 mysql） ---
MYSQL_ROOT_PASSWORD=
NUXT_MYSQL_HOST=127.0.0.1
NUXT_MYSQL_PORT=3306
NUXT_MYSQL_DATABASE=ctk_system
NUXT_MYSQL_USER=root
NUXT_MYSQL_PASSWORD=
NUXT_MYSQL_HOST_FALLBACK=
NUXT_MYSQL_CONNECT_TIMEOUT_MS=5000
NUXT_MYSQL_QUERY_TIMEOUT_MS=10000

# --- 演示环境专用库 ---
NUXT_DEMO_MYSQL_HOST=127.0.0.1
NUXT_DEMO_MYSQL_PORT=3306
NUXT_DEMO_MYSQL_DATABASE=ctk_system_demo
NUXT_DEMO_MYSQL_USER=
NUXT_DEMO_MYSQL_PASSWORD=
# 访问 /login?demo=1 或 /demo 时自动填充的演示账号（仅允许 demo，勿填生产账号）
NUXT_DEMO_LOGIN_USERNAME=demo
NUXT_DEMO_LOGIN_PASSWORD=

# --- Nitro 会话与令牌密钥 ---
NUXT_AUTH_TOKEN_SECRET=
NUXT_LEGACY_TOKEN_SECRET=
NUXT_TOKEN_EXPIRE_MINUTES=1440

# --- Jukebox 内嵌播放器配置（已并入 Nitro，默认 embedded；仅置 remote 时才使用旧 HTTP 地址/令牌） ---
NUXT_JUKEBOX_ENGINE_MODE=embedded
NUXT_JUKEBOX_ENGINE_ENABLED=1
NUXT_JUKEBOX_VOLUME=70
NUXT_JUKEBOX_MEDIA_TIMEOUT_MS=600000
NUXT_JUKEBOX_API_BASE_URL=
NUXT_JUKEBOX_SERVICE_TOKEN=

# --- 企微同步与通知链接 ---
NUXT_WECOM_CORP_ID=
NUXT_WECOM_CORP_SECRET=
NUXT_WECOM_CORP_SECRET_CONTACTS=
NUXT_QUOTATION_APP_INTERNAL_URL=http://localhost:3100
NUXT_QUOTATION_APP_EXTERNAL_URL=https://your-domain.example.com
NUXT_WECOM_AUTO_SYNC_ENABLED=1
NUXT_WECOM_AUTO_SYNC_INTERVAL_MS=3600000
NUXT_WECOM_AUTO_SYNC_INITIAL_DELAY_MS=30000

# --- 金蝶 K3Cloud WebAPI ---
NUXT_K3_BASE_URL=
NUXT_K3_BASE_URL_INTRANET=
NUXT_K3_DBID=
NUXT_K3_USERNAME=
NUXT_K3_PASSWORD=
NUXT_K3_APP_ID=
NUXT_K3_APP_SECRET=
# 注意：server/utils/k3-config.ts 会把精确的 5000 / 30000 视为未设置并回退到 sys_config 旧值 360，因此须使用非默认值
NUXT_K3_CONNECT_TIMEOUT_MS=8000
NUXT_K3_REQUEST_TIMEOUT_MS=60000

# --- 金蝶 SQL Server 直连 ---
NUXT_SQLSERVER_K3_HOST=
NUXT_SQLSERVER_K3_HOST_FALLBACK=
NUXT_SQLSERVER_K3_TLS_SERVER_NAME=
NUXT_SQLSERVER_K3_PORT=1433
NUXT_SQLSERVER_K3_DATABASE=
NUXT_SQLSERVER_K3_USER=
NUXT_SQLSERVER_K3_PASSWORD=
NUXT_SQLSERVER_K3_CONNECT_TIMEOUT_MS=5000
NUXT_SQLSERVER_K3_REQUEST_TIMEOUT_MS=30000
NUXT_SQLSERVER_K3_POOL_MAX=5

# --- 考勤库（只读） ---
NUXT_ATTENDANCE_MYSQL_HOST=
NUXT_ATTENDANCE_MYSQL_PORT=3306
NUXT_ATTENDANCE_MYSQL_USER=
NUXT_ATTENDANCE_MYSQL_PASSWORD=
NUXT_ATTENDANCE_MYSQL_DATABASE=

# --- IT 资产外源（绿盾）SSH 只读采集（可选） ---
NUXT_LVDUN_SSH_HOST=
NUXT_LVDUN_SSH_PORT=22
NUXT_LVDUN_SSH_USER=
NUXT_LVDUN_SSH_KEY_PATH=

# --- 后台定时任务开关（按实际生产口径设置） ---
NUXT_MO_CLOSE_ENABLED=0
NUXT_NITRO_JOB_KUCUN_FULL_SYNC=0
NUXT_NITRO_JOB_KUCUN_DIFF_SYNC=0
NUXT_NITRO_JOB_SUGGEST_PUSH=0
NUXT_NITRO_JOB_APPROVE_SYNC=0
NUXT_NITRO_JOB_APPROVE_SYNC_7D=0
NUXT_NITRO_JOB_KUCUN_WARNING_PUSH=0
NUXT_NITRO_JOB_BROADCAST_SYNC=0
NUXT_NITRO_JOB_UPLOAD_PATH=0
NUXT_NITRO_JOB_OVERDUE_AUTO_FREEZE=0
NUXT_NITRO_JOB_KUCUN_WARNING_SNAPSHOT=0
